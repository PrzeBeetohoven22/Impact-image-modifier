{
  "name": "Impact — testy zdjęć",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:24-bookworm",
  "remoteUser": "node",
  "hostRequirements": {
    "cpus": 2,
    "memory": "8gb"
  },
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "forwardPorts": [3001],
  "portsAttributes": {
    "3001": {
      "label": "Zdjęcia prelegentów",
      "onAutoForward": "notify",
      "protocol": "http"
    }
  }
}
