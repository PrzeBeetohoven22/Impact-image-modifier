# All credentials remain on the server. Never use a VITE_ prefix for credentials.
PORT=3001
HOST=127.0.0.1
# For deployment, set the externally visible HTTPS origin and register a matching OAuth callback.
# APP_ORIGIN=https://speaker-tool.example.org
# Optional Canva integration only. Leave these unset for the standalone PNG workflow.
CANVA_CLIENT_ID=
CANVA_REDIRECT_URI=
CANVA_BRAND_TEMPLATE_ID=
CANVA_IMAGE_FIELD=SPEAKER
# Preferred for proxy-managed environments: secret is the Base64 encoding of client_id:client_secret.
# Enter this only through secure environment settings. Base64 is NOT encryption.
CANVA_BASIC_AUTH=
# Alternative for local development with a real, securely injected secret (not a proxy placeholder):
CANVA_CLIENT_SECRET=
