{
  "name": "impact-image-modifier",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "concurrently -k -n api,ui \"tsx watch src/server/index.ts\" \"vite --host 127.0.0.1\"",
    "build": "tsc --noEmit && vite build && tsc -p tsconfig.server.json",
    "start": "node dist/server/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "check:models": "tsx scripts/check-models.ts",
    "canva:poc": "tsx scripts/canva-poc.ts",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@imgly/background-removal-node": "1.4.5",
    "@tensorflow/tfjs-backend-wasm": "4.22.0",
    "@tensorflow/tfjs-converter": "4.22.0",
    "@vladmandic/human": "3.3.6",
    "cookie-parser": "1.4.7",
    "dotenv": "17.2.3",
    "express": "5.1.0",
    "helmet": "8.1.0",
    "multer": "2.4.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "sharp": "0.35.5",
    "undici": "7.30.0",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@playwright/test": "1.56.1",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.5",
    "@types/multer": "2.0.0",
    "@types/node": "24.10.1",
    "@types/react": "19.2.5",
    "@types/react-dom": "19.2.3",
    "@types/supertest": "6.0.3",
    "@vitejs/plugin-react": "5.1.1",
    "concurrently": "10.0.5",
    "eslint": "9.39.1",
    "globals": "16.5.0",
    "prettier": "3.8.3",
    "supertest": "7.1.4",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vite": "7.3.7",
    "vitest": "5.0.3"
  },
  "overrides": {
    "@imgly/background-removal-node": {
      "sharp": "$sharp",
      "zod": "3.25.76",
      "lodash": "4.18.1"
    },
    "shell-quote": "1.11.0",
    "sharp": "$sharp"
  }
}
